const __vite__css = "/* Styles carried over unchanged from the original single-file app (app.html), so the look is identical. */\n  /* Palette unchanged (warm stone neutrals + fire orange); --field and --faint support the minimal style. */\n  :root { --bg:#fafaf9; --fg:#1c1917; --muted:#78716c; --faint:#a8a29e; --line:#e7e5e4; --field:#f1efed;\n          --accent:#c2410c; --card:#fff; --zone:#ea580c; }\n  @media (prefers-color-scheme: dark) {\n    :root { --bg:#1c1917; --fg:#f5f5f4; --muted:#a8a29e; --faint:#78716c; --line:#332e2b; --field:#26211f;\n            --accent:#fb923c; --card:#211d1b; --zone:#fb923c; }\n  }\n  * { box-sizing:border-box; }\n  html, body { height:100%; }\n  body { margin:0; font:14px/1.55 var(--sans, system-ui), sans-serif; background:var(--bg); color:var(--fg);\n         display:grid; grid-template-columns:360px 1fr; -webkit-font-smoothing:antialiased; }\n\n  /* ---------- Side panel: flat, airy, separated by hairlines instead of boxes ---------- */\n  aside { border-right:1px solid var(--line); padding:28px 24px 24px; display:flex; flex-direction:column; }\n  /* The panel's content (its own column, so the dock strip above it never scrolls away). */\n  .pscroll { display:flex; flex-direction:column; min-height:0; }\n  .dock { display:none; }\n  .apphead { align-self:stretch; max-width:calc(100% + 32px); margin:-14px -16px 12px; padding:16px 20px; border-radius:16px;\n             border:1px solid transparent; outline:none; transition:border-color .4s, background-color .4s; }\n  .apphead .chev { width:.8em; height:.8em; flex:none; color:var(--faint); margin-left:.25em; transform:rotate(90deg);   /* ‹ : slides left */\n                   transition:transform .5s var(--ease-out, ease), color .2s; }\n  @media (min-width:801px) {\n    .apphead { cursor:pointer; }\n    .apphead:hover { background-color:var(--field); }\n    .apphead:hover .chev { color:var(--accent); }\n    .apphead:focus-visible { border-color:var(--accent); }\n  }\n  @media (max-width:800px) { .apphead .chev { display:none; } }\n  aside h1 { margin:0; font-size:20px; font-weight:650; letter-spacing:-.015em; display:flex; align-items:center; gap:11px;\n             white-space:nowrap; }\n  aside h1::before { content:\"\"; flex:none; width:11px; height:11px; border-radius:50%; background:var(--accent);\n                     box-shadow:0 0 14px var(--accent); }\n  aside h1 + p { margin:5px 0 0; color:var(--faint); font-size:13px; }\n  /* Header title row and subtitle: shrink-wrapped so the script can scale each to the panel's full width. */\n  .apphead .fit { width:max-content; white-space:nowrap; }\n  section { padding:22px 0; border-top:1px solid var(--line); }\n  section h2 { margin:0 0 16px; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.09em; color:var(--faint); }\n  label { display:flex; flex-direction:column; gap:6px; font-size:11.5px; color:var(--muted); }\n  input, select { font:inherit; padding:8px 10px; border:1px solid transparent; border-radius:6px; background:var(--field);\n                  color:var(--fg); width:100%; transition:border-color .15s, background .15s; }\n  input:focus, select:focus { outline:none; border-color:var(--accent); background:var(--bg); }\n  .row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }\n  .btns { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }\n  button { font:inherit; font-weight:500; padding:8px 14px; border:1px solid transparent; border-radius:6px; background:var(--accent);\n           color:#fff; cursor:pointer; transition:background .15s, color .15s, border-color .15s, opacity .15s; }\n  button:hover:not(:disabled) { filter:brightness(1.06); }\n  button:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }\n  button.secondary { background:transparent; color:var(--fg); border-color:var(--line); }\n  button.secondary:hover:not(:disabled) { border-color:var(--accent); color:var(--accent); filter:none; }\n  button.on, button.secondary.on { background:var(--accent); border-color:var(--accent); color:#fff; }\n  button:disabled { opacity:.45; cursor:not-allowed; }\n  #run { width:100%; padding:11px; font-weight:600; font-size:14px; margin-top:4px; }\n  #run[hidden] { display:none; }\n\n  /* ---------- Black scrollbars (side panel + Analyse window) ---------- */\n  .pscroll, .dialog { scrollbar-width:thin; scrollbar-color:#3a3431 #000; }\n  .pscroll::-webkit-scrollbar, .dialog::-webkit-scrollbar { width:10px; }\n  .pscroll::-webkit-scrollbar-track, .dialog::-webkit-scrollbar-track { background:#000; }\n  .pscroll::-webkit-scrollbar-thumb, .dialog::-webkit-scrollbar-thumb { background:#3a3431; border-radius:5px; border:2px solid #000; }\n  .pscroll::-webkit-scrollbar-thumb:hover, .dialog::-webkit-scrollbar-thumb:hover { background:#57504c; }\n\n  /* ---------- Black map controls: + / − zoom buttons and the credits label ---------- */\n  .maplibregl-ctrl-group { background:#000 !important; box-shadow:0 0 0 1px #2a2523 !important; border-radius:6px; }\n  .maplibregl-ctrl-group button + button { border-top:1px solid #2a2523 !important; }\n  .maplibregl-ctrl-group button:hover:not(:disabled) { background:#1c1917 !important; filter:none; }\n  .maplibregl-ctrl-group button .maplibregl-ctrl-icon { filter:invert(1); }      /* dark icons → white */\n  .maplibregl-ctrl-attrib, .maplibregl-ctrl-attrib.maplibregl-compact { background:#000 !important; color:#a8a29e; }\n  .maplibregl-ctrl-attrib a { color:#d6d3d1 !important; }\n  .maplibregl-ctrl-attrib a:hover { color:var(--accent) !important; }\n  .maplibregl-ctrl-attrib-button { filter:invert(1); background-color:transparent !important; }\n\n  /* ---------- Analyse window ---------- */\n  #modal { position:fixed; inset:0; z-index:1500; display:flex; align-items:center; justify-content:center;\n           padding:16px; background:rgba(12,10,9,.5); backdrop-filter:blur(4px); }\n  #modal[hidden] { display:none; }\n  .dialog { width:100%; max-width:460px; max-height:calc(100vh - 32px); overflow-y:auto; background:var(--bg);\n            color:var(--fg); border:1px solid var(--line); border-radius:12px; padding:26px 26px 22px; box-shadow:0 24px 64px rgba(0,0,0,.3); }\n  .dialog header { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:2px; }\n  .dialog h2 { margin:0; font-size:16px; font-weight:600; }\n  .dialog .x { background:transparent; color:var(--faint); font-size:20px; line-height:1; padding:0 4px; border:0; }\n  .dialog .x:hover { color:var(--fg); filter:none; }\n  .dialog .sub { font-size:12px; color:var(--faint); margin:0 0 6px; font-variant-numeric:tabular-nums; }\n  .step { border-top:1px solid var(--line); padding-top:18px; margin-top:18px; }\n  .step h3 { margin:0 0 12px; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.09em; color:var(--faint); }\n  .step.locked h3, .step.locked p { opacity:.5; }\n  .choice { display:flex; gap:10px; align-items:flex-start; padding:12px 14px; border:1px solid var(--line); border-radius:8px;\n            margin-bottom:8px; cursor:pointer; flex-direction:row; color:var(--fg); font-size:13.5px; transition:border-color .15s, background .15s; }\n  .choice:hover { border-color:var(--faint); }\n  .choice:has(input:checked) { border-color:var(--accent); background:rgba(234, 88, 12, .05); }\n  .choice b { font-weight:600; }\n  .choice input { width:auto; margin:3px 0 0; accent-color:var(--accent); }\n  .choice small { display:block; color:var(--muted); font-size:12px; margin-top:2px; }\n  .choice select { margin-top:10px; }\n  .dialog .go { width:100%; padding:10px; font-weight:600; margin-top:6px; }\n  .dialog .msg { font-size:12px; color:var(--muted); margin:10px 0 0; min-height:1em; }\n  .dialog .msg.ok { color:#16a34a; }\n\n  /* ---------- Forecast panel ---------- */\n  button.small { padding:2px 0; font-size:12px; background:none; border:0; color:var(--muted); }\n  button.small:hover:not(:disabled) { color:var(--accent); filter:none; }\n  .fhead { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:8px; }\n  /* \"Change zone\": a clearly visible outlined pill with a back arrow; turns orange on hover. */\n  #changeZone { display:inline-flex; align-items:center; gap:7px; flex:none; padding:7px 14px; border-radius:999px;\n                border:1px solid rgba(255, 255, 255, .35); background:rgba(255, 255, 255, .08); color:var(--fg);\n                font-size:13px; font-weight:600; }\n  #changeZone:hover:not(:disabled) { border-color:var(--accent); color:#fff; background:var(--accent); filter:none; }\n  @media (prefers-color-scheme: light) { #changeZone { border-color:rgba(28, 25, 23, .3); background:rgba(28, 25, 23, .05); } }\n  .fhead h2 { margin:0; }\n  .fsub { font-size:12px; color:var(--faint); margin:0 0 16px; font-variant-numeric:tabular-nums; }\n  #forecastSection { animation:fadein .4s ease; }\n  @keyframes fadein { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }\n  /* Day tabs: plain text with an underline on the active day. */\n  .days { display:flex; border-bottom:1px solid var(--line); margin-bottom:18px; }\n  .days button { flex:1; background:transparent; color:var(--muted); border:0; border-bottom:2px solid transparent; border-radius:0;\n                 padding:6px 4px 8px; margin-bottom:-1px; font-size:12.5px; line-height:1.3; }\n  .days button small { display:block; color:var(--faint); font-size:11px; font-weight:400; }\n  .days button:hover:not(:disabled) { color:var(--fg); filter:none; }\n  .days button[aria-selected=\"true\"] { color:var(--accent); border-bottom-color:var(--accent); background:transparent; }\n  .days button[aria-selected=\"true\"] small { color:var(--muted); }\n  /* Stats: just the numbers and a small label, no boxes. */\n  .pstats { display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; }\n  .pstat { font-size:11px; color:var(--faint); line-height:1.35; }\n  .pstat b { display:block; font-size:20px; font-weight:600; color:var(--fg); font-variant-numeric:tabular-nums; margin-bottom:2px; }\n  .scale { display:flex; gap:8px; align-items:center; font-size:11px; color:var(--faint); margin:18px 0 4px; }\n  .scale span:first-child { margin-right:4px; }\n  .scale i { flex:1; height:4px; border-radius:2px; background:linear-gradient(90deg, #fde68a, #fbbf24 20%, #f97316 40%, #dc2626 66%, #7f1d1d); }\n  .facts { margin:16px 0 0; padding-left:16px; font-size:12.5px; color:var(--muted); }\n  .facts li { margin:5px 0; }\n  .facts li::marker { color:var(--faint); }\n  .facts b { color:var(--fg); }\n  #hotspots h4 { margin:20px 0 4px; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.09em; color:var(--faint); }\n  .hot { display:flex; justify-content:space-between; width:100%; background:transparent; color:var(--fg); border:0;\n         border-bottom:1px solid var(--line); border-radius:0; padding:8px 0; font-size:12.5px; font-weight:400; font-variant-numeric:tabular-nums; }\n  .hot:hover:not(:disabled) { color:var(--accent); filter:none; }\n  .hot b { color:var(--accent); font-weight:600; }\n  .reliab { font-size:12px; color:var(--muted); border-left:2px solid var(--accent); padding:2px 0 2px 12px; margin:20px 0 0; }\n  .reliab b { color:var(--fg); }\n  .zoneinfo { font-size:13px; margin-top:10px; font-variant-numeric:tabular-nums; color:var(--fg); }\n  .zoneinfo b { font-weight:600; }\n\n  /* ---------- Zone selection: one block per method, separated by space rather than lines ---------- */\n  .methodpick select { margin-top:0; cursor:pointer; font-weight:500; color:var(--fg); }\n  .method { padding:12px 0 2px; }\n  .method[hidden] { display:none; }\n  .method:not([hidden]) { animation:fadein .25s ease; }\n  .mhead { display:flex; align-items:center; gap:8px; font-weight:600; font-size:13px; margin-bottom:2px; }\n  .mhead .ico { flex:none; display:grid; place-items:center; color:var(--accent); }\n  .method .hint { margin:2px 0 10px; }\n  button.wide { width:100%; }\n  .selected { border-top:1px solid var(--line); padding-top:16px; margin-top:16px; animation:fadein .25s ease; }\n  .selected[hidden] { display:none; }\n  .selected .mhead { font-size:11px; text-transform:uppercase; letter-spacing:.09em; color:var(--faint); }\n  .selected .zoneinfo { margin-top:4px; }\n  /* \"Clear zone\": a clearly visible outlined button with an × icon; turns red on hover (it removes the zone). */\n  .selected #clear { width:100%; display:flex; align-items:center; justify-content:center; gap:8px; margin-top:14px !important;\n                     padding:9px 14px; border:1px solid var(--muted); border-radius:6px; background:transparent;\n                     color:var(--fg); font-size:13px; font-weight:500; }\n  .selected #clear svg { flex:none; }\n  .selected #clear:hover:not(:disabled) { border-color:#ef4444; color:#ef4444; background:rgba(239, 68, 68, .08); filter:none; }\n  .pinrow { display:grid; grid-template-columns:1fr auto; gap:8px; align-items:end; }\n  #pin { display:inline-flex; align-items:center; gap:6px; white-space:nowrap; height:36px; }\n  /* The pin on the map (tip anchored at the bottom centre). */\n  .map-pin { width:28px; height:40px; cursor:grab; filter:drop-shadow(0 3px 4px rgba(0,0,0,.45)) drop-shadow(0 0 8px rgba(249,115,22,.55)); }\n  .map-pin:active { cursor:grabbing; }\n  .map-pin svg { display:block; animation:pin-drop .45s cubic-bezier(.3, 1.4, .5, 1) both; transform-origin:50% 100%; }\n  @keyframes pin-drop { from { transform:translateY(-28px) scale(.9); opacity:0; } to { transform:none; opacity:1; } }\n  @media (prefers-reduced-motion: reduce) { .map-pin svg { animation:none; } }\n  .hint { font-size:12px; color:var(--muted); margin:6px 0 0; }\n  .error { color:#dc2626; }\n  /* The map canvas is transparent around the globe, so the space scene below shows through. */\n  #map { height:100%; position:relative; background:transparent; }\n  .fire-pop { z-index:8; }                      /* the fire card stays above the legend, timeline and territory bar */\n\n  /* ---------- Space backdrop behind the globe: night sky, smoky ember nebula, rising sparks ---------- */\n  .space { position:absolute; inset:0; overflow:hidden; pointer-events:none;\n           background:radial-gradient(ellipse 80% 70% at 55% 50%, #120a10 0%, #07040a 55%, #020103 100%); }\n  .space .nebula { position:absolute; inset:-25%; filter:blur(40px); opacity:.95;\n    background:\n      radial-gradient(ellipse 40% 32% at 22% 82%, rgba(220, 38, 38, .42), transparent 70%),\n      radial-gradient(ellipse 32% 26% at 36% 96%, rgba(249, 115, 22, .38), transparent 70%),\n      radial-gradient(ellipse 34% 28% at 86% 22%, rgba(234, 88, 12, .26), transparent 70%),\n      radial-gradient(ellipse 30% 24% at 72% 12%, rgba(185, 28, 28, .22), transparent 70%),\n      radial-gradient(ellipse 42% 34% at 82% 84%, rgba(91, 33, 182, .22), transparent 70%),\n      radial-gradient(ellipse 30% 24% at 40% 16%, rgba(76, 29, 149, .16), transparent 70%);\n    animation:nebula-drift 80s ease-in-out infinite alternate; }\n  @keyframes nebula-drift { from { transform:translate(-2%, 1%) scale(1); } to { transform:translate(2%, -2%) scale(1.06); } }\n  .space .stars { position:absolute; inset:0; background-repeat:repeat; }\n  .space .stars.far  { background-image:var(--stars-far);  background-size:520px 520px; opacity:.8; }\n  .space .stars.near { background-image:var(--stars-near); background-size:760px 760px;\n                       animation:twinkle 7s ease-in-out infinite alternate; }\n  @keyframes twinkle { 0% { opacity:.35; } 50% { opacity:1; } 100% { opacity:.55; } }\n  /* Low warm haze along the bottom, like light from fires below the horizon. */\n  .space::after { content:\"\"; position:absolute; inset:auto 0 0 0; height:35%;\n                  background:linear-gradient(0deg, rgba(234, 88, 12, .10), transparent); }\n  #embers { position:absolute; inset:0; width:100%; height:100%; }\n  /* Warm glow hugging the globe's edge; positioned and sized from the camera in the script. */\n  .space .halo { position:absolute; left:0; top:0; width:100px; height:100px; border-radius:50%; will-change:transform, opacity;\n    background:radial-gradient(circle closest-side, transparent 58%, rgba(251, 146, 60, .42) 60.5%,\n               rgba(234, 88, 12, .18) 68%, rgba(185, 28, 28, .07) 82%, transparent 100%); }\n  @media (prefers-reduced-motion: reduce) { .space .nebula, .space .stars.near { animation:none; } }\n  #map.drawing .maplibregl-canvas-container { cursor:crosshair; }\n  .maplibregl-popup-content { background:var(--card); color:var(--fg); font-size:12px; }\n  .maplibregl-popup-tip { border-top-color:var(--card) !important; border-bottom-color:var(--card) !important; }\n  .maptip { position:absolute; top:12px; left:50%; transform:translateX(-50%); z-index:1000; background:var(--card); color:var(--fg);\n            border:1px solid var(--line); border-radius:999px; padding:6px 14px; font-size:13px; box-shadow:0 2px 8px rgba(0,0,0,.15); display:none; }\n  .mapwrap { position:relative; }\n  .legend { position:relative; z-index:5; background:var(--card); color:var(--fg);\n            border:1px solid var(--line); border-radius:10px; padding:10px 12px; font-size:12px; max-width:220px;\n            box-shadow:0 4px 16px rgba(0,0,0,.25); }\n  .legend[hidden] { display:none; }\n  .legend small { display:block; color:var(--muted); font-size:11px; line-height:1.35; margin:2px 0 8px; }\n  .legend ul { list-style:none; margin:0; padding:0; display:grid; gap:5px; }\n  .legend li { display:flex; align-items:center; gap:8px; font-variant-numeric:tabular-nums; }\n  .legend i { flex:none; width:12px; display:flex; justify-content:center; }\n  .legend i::before { content:\"\"; width:var(--r); height:var(--r); border-radius:50%; background:var(--c);\n                      box-shadow:0 0 0 .5px #00000066; }\n  table { border-collapse:collapse; width:100%; font-size:12px; }\n  td { padding:2px 0; } td:last-child { text-align:right; }\n  /* ---------- Opening screen ---------- */\n  body.splash .maptip { display:none !important; }\n  #splash { position:fixed; inset:0; z-index:2000; display:flex; align-items:center; justify-content:flex-start;\n            padding:6vh 7vw; color:#fff7ed; }\n  /* The globe shows in true colour, as a satellite sees it; only a touch dimmer than in the app, so the text reads\n     (it brightens back on entering the app). The text side is darkened by the shade below. */\n  body.splash #map, body.splash .space { filter:brightness(.88) saturate(1.05); }\n\n  /* ---------- Desktop layout: the map stays full-screen and the side panel floats over it ----------\n     (so the map never has to be resized, which would blank the globe; the map is told to keep\n      its content clear of the panel with camera padding instead, see PANEL_W in the script) */\n  @media (min-width:801px) {\n    body { display:block; }\n    .mapwrap { position:fixed; inset:0; }\n    aside { position:fixed; top:0; bottom:0; left:0; width:360px; z-index:10; background:var(--bg);\n            box-shadow:4px 0 24px rgba(0,0,0,.18); will-change:transform; }\n    .maptip { left:calc(50% + 180px); }\n  }\n\n  /* ---------- Transition from the opening screen into the app (≈3 s, long overlapping eases) ---------- */\n  :root { --ease-out:cubic-bezier(.22, 1, .36, 1); --ease-io:cubic-bezier(.45, 0, .25, 1); }\n  /* 1. Text drifts up, softens and fades. */\n  #splash.gone .content, #splash.gone .sp-top, #splash.gone .sp-status, #splash.gone .sp-readout { animation:leave .9s var(--ease-io) forwards; }\n  @keyframes leave { to { opacity:0; transform:translateY(-24px) scale(.985); filter:blur(8px); } }\n  /* 2. Fire wash and shading dissolve slowly while the globe's natural colours return. */\n  #splash.gone { opacity:0; visibility:hidden; pointer-events:none;\n                 transition:opacity 2.2s var(--ease-io) .15s, visibility 0s linear 2.35s; }\n  #map, .space { transition:filter 2.2s var(--ease-io) .15s; }\n  /* 3. After \"Get started\" the globe glides to the centre and a \"Fire Pattern Predictor\" pill fades in\n        top-left (desktop), together with the map controls. */\n  @media (max-width:800px) { body.splash aside { display:none; } }\n  body.splash .maplibregl-ctrl-top-right, body.splash .maplibregl-ctrl-bottom-right { opacity:0; transition-delay:0s; }\n  .maplibregl-ctrl-top-right, .maplibregl-ctrl-bottom-right { transition:opacity .9s ease 1.4s; }\n\n  /* ---------- Menu: Home · Globe · Fire, three little planets stacked at the left middle ----------\n     Slides in from the left after \"Get started\"; hides at once when going back Home. Each icon is its own glassy\n     planet; the active one glows like a sun. While the Fire Pattern Predictor is open (desktop) they dock in a\n     small row at the top of the panel, above its title; NavBar.tsx animates each planet between the two places. */\n  #nav { position:fixed; top:50%; left:16px; z-index:13; display:flex; flex-direction:column; gap:22px; padding:7px;\n         border-radius:999px; transform:translateY(-50%); pointer-events:none;\n         transition:opacity .5s ease, transform .7s cubic-bezier(.16, 1, .3, 1); }\n  #nav .nav-btn { pointer-events:auto; }                             /* the gaps between planets stay click-through */\n  body.splash #nav { visibility:hidden; opacity:0; transform:translate(-26px, -50%) scale(.96); transition-delay:0s; }\n  body.splash #nav .nav-btn { pointer-events:none; }\n  body.intro #nav { transition-delay:1.1s, 1.1s; }                   /* first appearance, after the opening screen */\n  /* Docked: a row of smaller planets centred across the top of the panel (panel middle 12 + 420 / 2 = 222px, less\n     half the row: 3 × 46 + 2 × 22 + 2 × 7 padding = 196px). The row's middle sits 24 + 23px below the panel top\n     (--panel-top is kept up to date by Panel.tsx), so the same translateY(-50%) holds in both places. */\n  @media (min-width:801px) {\n    body:not(.collapsed):not(.splash) #nav { flex-direction:row; gap:22px; left:124px; top:calc(var(--panel-top, 12px) + 47px); }\n    body:not(.collapsed):not(.splash) .nav-btn { width:46px; height:46px; animation:none; }\n    body:not(.collapsed):not(.splash) .nav-btn svg { width:22px; height:22px; }\n  }\n  /* Hovering the menu enlarges it a little, growing outwards from the screen edge, with a soft spring\n     (in its own place at the left edge only; docked in the panel it stays put). */\n  #nav { transform-origin:left center; }\n  body.collapsed:not(.splash) #nav:hover { transform:translateY(-50%) scale(1.14);\n    transition:opacity .5s ease, transform .4s cubic-bezier(.34, 1.56, .64, 1); }\n  /* Each icon's name pops out beside the menu while the icon is hovered (or focused with the keyboard). Beside it,\n     on the open-screen side: the menu sits at the left edge, so there's no room further left. */\n  .nav-label { position:absolute; left:calc(100% + 26px); top:50%; padding:7px 13px; border-radius:999px;\n               white-space:nowrap; pointer-events:none; font-size:13px; font-weight:600; letter-spacing:.01em;\n               color:var(--fg); background:color-mix(in srgb, var(--bg) 88%, transparent);\n               border:1px solid var(--glass-edge); box-shadow:0 8px 24px rgba(0, 0, 0, .3);\n               opacity:0; transform:translate(-8px, -50%) scale(.9); transform-origin:left center;\n               transition:opacity .18s ease, transform .3s cubic-bezier(.34, 1.56, .64, 1); }\n  .nav-btn:hover .nav-label, .nav-btn:focus-visible .nav-label { opacity:1; transform:translate(0, -50%) scale(1); }\n  /* Docked in the centred row, the name drops in just below its planet, in the gap above the panel title. */\n  @media (min-width:801px) {\n    body:not(.collapsed):not(.splash) .nav-label { font-size:11.5px; line-height:1.3; padding:3px 9px; left:50%; top:calc(100% + 4px);\n                                                   transform:translate(-50%, -4px) scale(.92); transform-origin:center top; }\n    body:not(.collapsed):not(.splash) .nav-btn:hover .nav-label,\n    body:not(.collapsed):not(.splash) .nav-btn:focus-visible .nav-label { transform:translate(-50%, 0) scale(1); }\n    /* Docked, a hovered planet keeps its size (the halo marks it), so every name lands in the same spot. */\n    body:not(.collapsed):not(.splash) .nav-btn:hover:not(:disabled) { transform:none; }\n  }\n  /* Each planet: a dark glass sphere lit from the top left, with a night side, a thin rim and a faint warm\n     atmosphere. They drift up and down a little, each on its own rhythm. */\n  .nav-btn { position:relative; z-index:1; width:52px; height:52px; padding:0; display:grid; place-items:center;\n             border:0; border-radius:50%; color:var(--muted); cursor:pointer; isolation:isolate;\n             background:radial-gradient(circle at 34% 28%, rgba(255, 255, 255, .26), rgba(255, 255, 255, .07) 36%,\n                                         rgba(12, 9, 8, .5) 72%, rgba(0, 0, 0, .7));\n             -webkit-backdrop-filter:blur(14px) saturate(140%); backdrop-filter:blur(14px) saturate(140%);\n             box-shadow:inset -7px -9px 16px rgba(0, 0, 0, .55), inset 2px 3px 7px rgba(255, 255, 255, .14),\n                        0 0 0 1px var(--glass-edge), 0 10px 24px rgba(0, 0, 0, .38), 0 0 16px rgba(249, 115, 22, .14);\n             transition:color .3s ease, transform .25s cubic-bezier(.34, 1.56, .64, 1), box-shadow .3s ease;\n             animation:planet-drift 6s ease-in-out infinite; }\n  .nav-btn:nth-child(2) { animation-duration:7s; animation-delay:-2.4s; }\n  .nav-btn:nth-child(3) { animation-duration:6.5s; animation-delay:-4.1s; }\n  @keyframes planet-drift { 0%, 100% { translate:0 0; } 50% { translate:0 -2.5px; } }\n  /* The active planet turns into a small sun (a glowing layer that fades in, so the change is smooth). */\n  .nav-btn::after { content:\"\"; position:absolute; inset:0; z-index:-1; border-radius:50%; opacity:0;\n                    background:radial-gradient(circle at 34% 28%, #fde68a, #f59e0b 30%, #ea580c 62%, #9a3412);\n                    box-shadow:inset -6px -8px 14px rgba(124, 45, 18, .55), 0 0 20px rgba(234, 88, 12, .6);\n                    transition:opacity .45s ease; }\n  .nav-btn.active::after { opacity:1; }\n  /* Hover: the same orange halo as the big globe's (same gradient, its bright ring sitting right on the\n     planet's edge: the edge is at 60% of the halo's radius, so the halo is 1 / 0.6 of the planet's width). */\n  .nav-btn::before { content:\"\"; position:absolute; inset:-33.333%; z-index:-1; border-radius:50%; pointer-events:none;\n                     background:radial-gradient(circle closest-side, transparent 58%, rgba(251, 146, 60, .42) 60.5%,\n                                rgba(234, 88, 12, .18) 68%, rgba(185, 28, 28, .07) 82%, transparent 100%);\n                     opacity:0; transform:scale(.85); transition:opacity .3s ease, transform .4s cubic-bezier(.34, 1.56, .64, 1); }\n  .nav-btn:hover::before, .nav-btn:focus-visible::before { opacity:1; transform:scale(1); }\n  .nav-btn:hover:not(:disabled) { color:var(--fg); filter:none; transform:scale(1.08);\n    box-shadow:inset -7px -9px 16px rgba(0, 0, 0, .5), inset 2px 3px 7px rgba(255, 255, 255, .18),\n               0 0 0 1px var(--glass-edge), 0 10px 24px rgba(0, 0, 0, .38); }\n  .nav-btn:active { transform:scale(.94); }\n  .nav-btn svg { transition:transform .3s cubic-bezier(.34, 1.56, .64, 1); filter:drop-shadow(0 1px 2px rgba(0, 0, 0, .45)); }\n  .nav-btn:hover svg { transform:scale(1.1); }\n  /* Two-tone icons: a faint fill inside each shape, a little stronger when hovered or active; the flame's core is solid. */\n  .nav-btn svg .tone { fill:currentColor; opacity:.16; transition:opacity .3s ease; }\n  .nav-btn:hover svg .tone, .nav-btn.active svg .tone { opacity:.28; }\n  .nav-btn svg .core { opacity:.9; }\n  .nav-btn.active { color:#fff; }\n  .nav-btn:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }\n  /* The fire icon flickers gently while the Fire Pattern Predictor is open. */\n  .nav-btn.active .flame { animation:flicker 1.8s ease-in-out infinite; transform-origin:50% 90%; }\n  @keyframes flicker { 0%, 100% { transform:scale(1) rotate(0); } 30% { transform:scale(1.07, 1.1) rotate(-2deg); }\n                       60% { transform:scale(.97, 1.03) rotate(2deg); } }\n  /* Coming back Home: the opening screen fades back in over the globe (its text rises as on first load). */\n  #splash.again { animation:splash-in 1s var(--ease-io) both; }\n  @keyframes splash-in { from { opacity:0; } to { opacity:1; } }\n  @media (prefers-reduced-motion: reduce) {\n    #nav, .nav-btn, .nav-btn::before, .nav-btn::after, .nav-btn svg, .nav-label { transition:none !important; }\n    .nav-btn, .nav-btn.active .flame, #splash.again { animation:none; }\n  }\n\n  /* 4. Clicking the pill slides the (wider) panel in from the left edge; its sections then fade in one\n        after another. Clicking the panel header slides it back out to the left and the pill returns. */\n  @media (min-width:801px) {\n    aside { transition:transform .75s cubic-bezier(.16, 1, .3, 1), opacity .45s ease; will-change:transform, opacity; }\n    /* Closed: parked just off-screen at a near-zero (not zero) opacity, so the browser keeps the blurred glass\n       layer prepared; with opacity 0 it was only built on the first click, which made the first slide-in stutter. */\n    body.collapsed aside { transform:translateX(calc(-100% - 40px)); opacity:.01; pointer-events:none; visibility:hidden;\n                           transition:transform .55s cubic-bezier(.7, 0, .84, 0), opacity .35s ease .2s, visibility 0s linear .6s; }\n    .pscroll > * { transition:opacity .5s var(--ease-out), transform .5s var(--ease-out); }\n    .pscroll > :nth-child(1) { transition-delay:.25s; }\n    .pscroll > :nth-child(2) { transition-delay:.32s; }\n    .pscroll > :nth-child(3) { transition-delay:.4s; }\n    .pscroll > :nth-child(4) { transition-delay:.48s; }\n    .pscroll > :nth-child(5) { transition-delay:.56s; }\n    .pscroll > :nth-child(n+6) { transition-delay:.62s; }\n    body.collapsed .pscroll > * { opacity:.01; transform:translateX(-18px); transition-duration:.2s; transition-delay:0s; }\n  }\n  /* ---------- Opening screen, laid out like a satellite Earth viewer ----------\n     True-colour globe on the right; a thin top bar, the title column on the left, a centre readout, corner\n     viewfinder marks and a status bar of satellite feeds. One left/right edge for everything: --sp-x. */\n  #splash { --sp-x:clamp(20px, 5.5vw, 88px); --sp-ink:#f5f5f4; --sp-dim:rgba(231, 229, 228, .62); --sp-line:rgba(231, 229, 228, .14);\n            --sp-hot:#fb923c; padding:96px var(--sp-x) 120px; color:var(--sp-ink); }\n  #splash .mono { font-family:var(--mono);\n                  font-variant-numeric:tabular-nums; }\n  #splash .shade { position:absolute; inset:0; pointer-events:none;\n                   background:linear-gradient(90deg, rgba(5, 7, 10, .88) 0%, rgba(5, 7, 10, .62) 34%, rgba(5, 7, 10, 0) 60%),\n                              linear-gradient(0deg, rgba(5, 7, 10, .7) 0%, rgba(5, 7, 10, 0) 22%),\n                              linear-gradient(180deg, rgba(5, 7, 10, .55) 0%, rgba(5, 7, 10, 0) 16%); }\n  /* Viewfinder corners. */\n  #splash .sp-corner { position:absolute; width:18px; height:18px; border:0 solid rgba(231, 229, 228, .35); pointer-events:none;\n                       animation:fade 1.2s ease .6s both; }\n  #splash .sp-corner.tl { top:72px; left:calc(var(--sp-x) - 8px); border-top-width:1px; border-left-width:1px; }\n  #splash .sp-corner.tr { top:72px; right:calc(var(--sp-x) - 8px); border-top-width:1px; border-right-width:1px; }\n  #splash .sp-corner.bl { bottom:84px; left:calc(var(--sp-x) - 8px); border-bottom-width:1px; border-left-width:1px; }\n  #splash .sp-corner.br { bottom:84px; right:calc(var(--sp-x) - 8px); border-bottom-width:1px; border-right-width:1px; }\n\n  /* Top bar: brand left, live UTC clock right. */\n  #splash .sp-top { position:absolute; top:0; left:var(--sp-x); right:var(--sp-x); height:64px; display:flex; align-items:center;\n                    justify-content:space-between; gap:16px; border-bottom:1px solid var(--sp-line); animation:fade .8s ease .1s both; }\n  #splash .sp-brand { display:inline-flex; align-items:center; gap:10px; font-size:14px; font-weight:650; letter-spacing:-.005em; }\n  #splash .sp-brand svg { color:var(--sp-hot); }\n  #splash .sp-clock { display:inline-flex; align-items:center; gap:18px; font-size:12px; color:var(--sp-dim); }\n  #splash .sp-clock .strong { color:var(--sp-ink); }\n  #splash .sp-live { display:inline-flex; align-items:center; gap:8px; font-size:11px; font-weight:650; letter-spacing:.14em;\n                     text-transform:uppercase; color:var(--sp-ink); }\n  #splash .sp-live i, #splash .sp-feeds li.live i { position:relative; width:7px; height:7px; border-radius:50%; background:var(--sp-hot);\n                                                    box-shadow:0 0 8px rgba(249, 115, 22, .9); }\n  #splash .sp-live i::after { content:\"\"; position:absolute; inset:-4px; border-radius:50%; border:1.5px solid var(--sp-hot); opacity:0;\n                              animation:live 2.4s var(--ease-out) infinite; }\n  @keyframes live { 0% { transform:scale(.4); opacity:.9; } 100% { transform:scale(1.5); opacity:0; } }\n\n  /* Title column. */\n  #splash .content { position:relative; width:100%; max-width:min(560px, 42vw); }   /* stays left of the globe */\n  #splash .content > * { animation:rise .9s var(--ease-out) both; }\n  #splash .content > :nth-child(1) { animation-delay:.2s; }\n  #splash .content > :nth-child(2) { animation-delay:.28s; }\n  #splash .content > :nth-child(3) { animation-delay:.36s; }\n  #splash .content > :nth-child(4) { animation-delay:.44s; }\n  #splash .content > :nth-child(5) { animation-delay:.52s; }\n  #splash .eyebrow { margin:0 0 18px; font-size:12px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--sp-hot); }\n  #splash h1 { font-size:clamp(40px, 5.6vw, 72px); line-height:.98; margin:0 0 20px; font-weight:750; letter-spacing:-.035em;\n               text-wrap:balance; color:var(--sp-ink); }\n  #splash .lead { max-width:33em; font-size:16.5px; line-height:1.6; color:rgba(231, 229, 228, .8); margin:0 0 28px; text-wrap:pretty; }\n  /* Spec strip: three facts in a hairline-ruled row, values in mono. */\n  #splash .sp-specs { display:grid; grid-template-columns:repeat(3, auto); justify-content:start; gap:0; margin:0 0 32px;\n                      border-top:1px solid var(--sp-line); border-bottom:1px solid var(--sp-line); }\n  #splash .sp-specs div { padding:12px 22px 12px 0; }\n  #splash .sp-specs div + div { padding-left:22px; border-left:1px solid var(--sp-line); }\n  #splash .sp-specs dt { font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--sp-dim); margin-bottom:4px; }\n  #splash .sp-specs dd { margin:0; font-size:14px; font-weight:600; color:var(--sp-ink); white-space:nowrap; }\n  /* Main action: steps up on hover, presses on click, the arrow leans forward. */\n  #start { display:inline-flex; align-items:center; gap:10px; font:inherit; font-size:15px; font-weight:650; letter-spacing:-.005em;\n           padding:14px 22px 14px 24px; border:0; border-radius:10px; color:#1c0a02; cursor:pointer; background:#fb923c;\n           box-shadow:0 8px 28px rgba(249, 115, 22, .35), 0 1px 0 rgba(255, 255, 255, .35) inset;\n           transition:transform .3s cubic-bezier(.34, 1.4, .64, 1), box-shadow .25s ease, background-color .2s ease; }\n  #start .arrow { display:inline-block; transition:transform .3s cubic-bezier(.34, 1.4, .64, 1); }\n  @media (hover:hover) {\n    #start:hover { background:#fdba74; transform:translateY(-2px); box-shadow:0 12px 36px rgba(249, 115, 22, .45), 0 1px 0 rgba(255, 255, 255, .35) inset; }\n    #start:hover .arrow { transform:translateX(4px); }\n  }\n  #start:active { transform:scale(.97); transition-duration:.08s; }\n  #start:focus-visible { outline:2px solid #fef3c7; outline-offset:3px; }\n  #start:disabled { cursor:default; }\n\n  /* Centre readout, under the globe on the right. */\n  #splash .sp-readout { position:absolute; right:var(--sp-x); bottom:104px; margin:0; display:flex; gap:14px; align-items:baseline;\n                        font-size:12px; color:var(--sp-dim); animation:fade 1s ease .7s both; }\n  #splash .sp-readout span { font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; }\n  #splash .sp-readout b { font-weight:500; color:var(--sp-ink); min-width:8.5ch; text-align:right; }\n\n  /* Status bar: the satellite feeds with their latest data, then the credits. */\n  #splash .sp-status { position:absolute; left:var(--sp-x); right:var(--sp-x); bottom:0; min-height:64px; display:flex; align-items:center;\n                       justify-content:space-between; gap:24px; border-top:1px solid var(--sp-line); animation:fade .8s ease .5s both; }\n  #splash .sp-feeds { list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:6px 18px; }\n  #splash .sp-feeds li { display:inline-flex; align-items:center; gap:7px; font-size:11.5px; color:var(--sp-dim); }\n  #splash .sp-feeds li i { width:7px; height:7px; border-radius:50%; background:rgba(231, 229, 228, .3); }\n  #splash .sp-feeds li.lag i { background:#a8a29e; }\n  #splash .sp-feeds .name { font-weight:650; color:var(--sp-ink); }\n  #splash .sp-feeds .date { color:var(--sp-ink); }\n  #splash .credit { margin:0; font-size:11.5px; color:rgba(231, 229, 228, .45); white-space:nowrap; }\n  @keyframes rise { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }\n  @keyframes fade { from { opacity:0; } to { opacity:1; } }\n\n  @media (max-width:1100px) {\n    #splash .sp-status { flex-direction:column; align-items:flex-start; justify-content:center; gap:6px; padding:12px 0; }\n    #splash .sp-readout { bottom:124px; }\n    #splash .sp-corner.bl, #splash .sp-corner.br { bottom:104px; }\n  }\n  @media (max-width:800px) {\n    #splash { align-items:flex-end; padding:72px var(--sp-x) 132px; }\n    #splash .shade { background:linear-gradient(0deg, rgba(5, 7, 10, .94) 0%, rgba(5, 7, 10, .75) 55%, rgba(5, 7, 10, .15) 100%); }\n    #splash .content { max-width:none; }\n    #splash .sp-top { height:56px; }\n    #splash .sp-clock > .mono:not(.strong) { display:none; }\n    #splash .sp-corner, #splash .sp-readout { display:none; }\n    #splash h1 { margin-bottom:14px; }\n    #splash .lead { font-size:15px; margin-bottom:20px; }\n    #splash .sp-specs { grid-template-columns:1fr 1fr 1fr; margin-bottom:22px; }\n    #splash .sp-specs div { padding-right:10px; }\n    #splash .sp-specs div + div { padding-left:10px; }\n    #splash .sp-specs dd { font-size:12.5px; white-space:normal; }\n    #start { width:100%; justify-content:center; min-height:48px; }\n    #splash .sp-feeds { gap:4px 14px; }\n    #splash .sp-feeds .name { display:none; }\n    #splash .sp-feeds .sat { color:var(--sp-ink); font-weight:600; }\n  }\n  @media (prefers-contrast: more) {\n    #splash { --sp-dim:#e7e5e4; --sp-line:rgba(231, 229, 228, .5); }\n    #splash .lead { color:#f5f5f4; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #splash .content > *, #splash .sp-top, #splash .sp-status, #splash .sp-readout, #splash .sp-corner, #splash .sp-live i::after,\n    #splash.gone .content, #splash.gone .sp-top, #splash.gone .sp-status, #splash.gone .sp-readout { animation:none; }\n    #start, #start .arrow { transition:none; }\n    body, aside, .pscroll > *, .apphead .chev, #nav, #splash.gone, #map, .space, .maplibregl-ctrl-top-right,\n    .maplibregl-ctrl-bottom-right { transition:none !important; }\n  }\n\n  @media (max-width:800px) {\n    body { grid-template-columns:1fr; grid-template-rows:55vh auto; }\n    .mapwrap { order:-1; }\n    aside { border-right:0; }\n  }\n\n  /* =====================================================================================\n     Glass: every panel, menu and map overlay is translucent frosted glass (iOS style).\n     A strong blur + saturation of whatever is behind, a thin light edge, a soft top highlight\n     and a gentle shadow. Lines and input fields inside become translucent too.\n     ===================================================================================== */\n  :root { --glass:rgba(250, 250, 249, .34); --glass-strong:rgba(250, 250, 249, .5); --glass-edge:rgba(255, 255, 255, .6);\n          --glass-hi:rgba(255, 255, 255, .65); --glass-blur:blur(30px) saturate(190%) brightness(1.08);\n          --line:rgba(28, 25, 23, .1); --field:rgba(28, 25, 23, .06); }\n  @media (prefers-color-scheme: dark) {\n    /* More see-through: a lighter tint, with the backdrop itself blurred harder and dimmed slightly\n       (like iOS) so text stays readable even though much more of the map shows through. */\n    :root { --glass:rgba(24, 21, 19, .3); --glass-strong:rgba(24, 21, 19, .45); --glass-edge:rgba(255, 255, 255, .14);\n            --glass-hi:rgba(255, 255, 255, .1); --line:rgba(255, 255, 255, .12); --field:rgba(255, 255, 255, .08);\n            --glass-blur:blur(30px) saturate(190%) brightness(.72);\n            /* brighter secondary text so it stays readable over bright map imagery seen through the glass */\n            --muted:#d0cbc7; --faint:#a9a19c; }\n  }\n  .glass, aside, .dialog, .legend, .maptip, .maplibregl-popup-content {\n    background:var(--glass) !important;\n    -webkit-backdrop-filter:var(--glass-blur); backdrop-filter:var(--glass-blur);\n    border:1px solid var(--glass-edge);\n    box-shadow:inset 0 1px 0 var(--glass-hi), 0 12px 40px rgba(0, 0, 0, .28);\n  }\n  /* Native dropdown lists can't be glass; keep their options readable. */\n  select option { background:#1c1917; color:#f5f5f4; }\n  @media (prefers-color-scheme: light) { select option { background:#fafaf9; color:#1c1917; } }\n\n  /* Side panel (desktop): a wide floating rounded glass card, 12px from the edges. It occupies\n     12 + 420 + 12 = 444px, which is PANEL_W in the script (the map keeps its content clear of it).\n     Its top keeps room for the menu planets, which dock there in a row while it's open. */\n  @media (min-width:801px) {\n    /* The card is as tall as its content (no empty glass at the bottom), up to the full height, then it scrolls.\n       It's centred vertically at the left middle (fit-content height between the 12px insets, auto margins). */\n    aside { top:12px; left:12px; bottom:12px; height:fit-content; margin:auto 0; max-height:calc(100vh - 24px);\n            width:420px; border-radius:24px; padding:0; overflow:hidden; font-size:14px; }\n    /* The top strip holds the docked menu planets (24px from the top, 46px tall, with room for a hovered planet's\n       name below) and never scrolls; the content scrolls below it, so it never slides under the planets. */\n    .dock { display:block; flex:none; height:84px; }\n    .pscroll { flex:0 1 auto; overflow-y:auto; overflow-x:hidden; padding:14px 30px 6px;\n               /* Scrolled content fades out softly under the strip (the fade sits in the empty top padding). */\n               -webkit-mask-image:linear-gradient(to bottom, transparent 0, #000 14px);\n               mask-image:linear-gradient(to bottom, transparent 0, #000 14px); }\n    /* Bottom: the last section's own spacing is enough; the Analyse button keeps its room below. */\n    #run { margin-bottom:22px; }\n    #status:empty { display:none; }\n    .apphead:hover { background-color:rgba(255, 255, 255, .06); }\n    .maptip { left:calc(50% + 222px); }\n  }\n  /* Phones: the panel sits under the map, so give it a lightly frosted look over the page. */\n  @media (max-width:800px) { aside { border-width:1px 0 0; border-radius:20px 20px 0 0; box-shadow:none; } }\n\n  /* Scrollbars: thin black thumbs on a clear track, so the glass shows through. */\n  .pscroll, .dialog { scrollbar-color:rgba(0, 0, 0, .55) transparent; }\n  .pscroll::-webkit-scrollbar-track, .dialog::-webkit-scrollbar-track { background:transparent; }\n  .pscroll::-webkit-scrollbar-thumb, .dialog::-webkit-scrollbar-thumb { background:rgba(0, 0, 0, .55); border:2px solid transparent;\n                                                                      background-clip:padding-box; }\n  .pscroll::-webkit-scrollbar-thumb:hover, .dialog::-webkit-scrollbar-thumb:hover { background:rgba(0, 0, 0, .8); background-clip:padding-box; }\n\n  /* Analyse window: a glass card over a lightly dimmed, blurred map. */\n  #modal { background:rgba(10, 8, 7, .28); -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px); }\n  .dialog { border-radius:20px; }\n  .choice { background:rgba(255, 255, 255, .03); }\n  .choice:has(input:checked) { background:rgba(234, 88, 12, .12); }\n\n  /* Map overlays */\n  .legend { border-radius:14px; }\n  .maptip { border-radius:999px; }\n  .maplibregl-popup-content { border-radius:12px; }\n  .maplibregl-popup-tip { border-top-color:rgba(28, 25, 23, .6) !important; border-bottom-color:rgba(28, 25, 23, .6) !important; }\n  /* Zoom buttons and credits: dark (black-tinted) glass. */\n  .maplibregl-ctrl-group, .maplibregl-ctrl-attrib, .maplibregl-ctrl-attrib.maplibregl-compact {\n    background:rgba(0, 0, 0, .26) !important; -webkit-backdrop-filter:var(--glass-blur); backdrop-filter:var(--glass-blur);\n    box-shadow:inset 0 1px 0 rgba(255, 255, 255, .08), 0 0 0 1px rgba(255, 255, 255, .1) !important; }\n  .maplibregl-ctrl-group { border-radius:12px !important; overflow:hidden; }\n  .maplibregl-ctrl-group button + button { border-top:1px solid rgba(255, 255, 255, .1) !important; }\n  .maplibregl-ctrl-group button:hover:not(:disabled) { background:rgba(255, 255, 255, .1) !important; }\n  .maplibregl-ctrl-attrib, .maplibregl-ctrl-attrib.maplibregl-compact { border-radius:999px; }\n  /* Translucent, softer secondary buttons inside the glass. */\n  button.secondary { background:rgba(255, 255, 255, .04); }\n  button.secondary:hover:not(:disabled) { background:rgba(234, 88, 12, .1); }\n  @media (prefers-reduced-transparency: reduce) {\n    .glass, aside, .dialog, .legend, .maptip, .maplibregl-popup-content { background:var(--bg) !important; backdrop-filter:none; }\n  }\n\n  /* React renders everything inside #root; make it layout-transparent so the body grid (phones) still applies\n     to the panel and the map directly, exactly as in the original single-file app. */\n  #root { display:contents; }\n\n  /* =====================================================================================\n     Forecast panel, grouped: each kind of information sits in its own titled glass card.\n     ===================================================================================== */\n  .fgroup { margin-top:12px; padding:14px 16px 16px; border-radius:14px; border:1px solid var(--line);\n            background:rgba(255, 255, 255, .035); }\n  .fgt { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:12px;\n         font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.09em; color:var(--faint); }\n  .fgt button.small { text-transform:none; letter-spacing:0; font-weight:500; margin:0; }\n  .gsub { margin:0 0 10px; font-size:12px; color:var(--muted); }\n  .fgroup .days { margin-bottom:14px; }\n  .fgroup .pstats { gap:10px; }\n  .fgroup .pstat { font-size:11.5px; color:var(--muted); }\n  .fgroup .pstat b { font-size:24px; margin-bottom:3px; }\n  .fgroup .scale { margin:16px 0 0; }\n\n  /* Key–value rows (About this forecast, trend/spread, ranking). */\n  .meta { display:grid; grid-template-columns:auto 1fr; gap:6px 14px; margin:0; font-size:12.5px; }\n  .meta dt { color:var(--faint); }\n  .meta dd { margin:0; color:var(--fg); font-variant-numeric:tabular-nums; min-width:0; }\n  .meta .dim { color:var(--faint); }\n  .fgroup .facts { margin-top:14px; padding:0; }\n  .trend { display:inline-block; margin-right:6px; font-size:10px; color:var(--muted); }\n  .notes { margin:12px 0 0; font-size:11.5px; color:var(--faint); line-height:1.45; }\n  .warn { margin:0; font-size:12.5px; color:#fbbf24; }\n\n  /* Hotspot list inside its card: no line under the last row. */\n  .fgroup #hotspots .hot:last-child { border-bottom:0; }\n  .fgroup #hotspots .hot { padding:7px 0; }\n\n  /* Daily activity: thin columns (<= 24px) from one hairline baseline, 4px rounded tops, the latest\n     value labelled at its cap, a tooltip on hover/focus. Text stays in text colours, never the data colour. */\n  .cols { display:flex; align-items:stretch; gap:6px; height:96px; padding-top:18px; border-bottom:1px solid var(--line); }\n  .col { position:relative; flex:1; display:flex; flex-direction:column; align-items:center; outline:none; cursor:default; }\n  .colbar-wrap { position:relative; flex:1; width:100%; display:flex; align-items:flex-end; justify-content:center; }\n  .colbar { width:min(24px, 70%); background:#ea580c; border-radius:4px 4px 0 0; transition:filter .15s; }\n  .col:hover .colbar, .col:focus-visible .colbar { filter:brightness(1.2); }\n  .colcap { position:absolute; left:50%; transform:translate(-50%, -4px); font-size:11.5px; font-weight:600;\n            color:var(--fg); white-space:nowrap; }\n  .coldate { position:absolute; top:100%; margin-top:5px; font-size:10.5px; color:var(--faint); white-space:nowrap; }\n  .cols + .meta { margin-top:30px; }\n\n  /* Model vs \"same as yesterday\": horizontal bars, 10px thick, rounded at the data end. */\n  .hbars { display:grid; gap:9px; margin:4px 0 14px; }\n  .hbar { position:relative; display:grid; grid-template-columns:118px 1fr 40px; align-items:center; gap:10px;\n          font-size:12.5px; outline:none; }\n  .hname { color:var(--muted); }\n  .htrack { height:10px; }\n  .hfill { display:block; height:100%; background:#ea580c; border-radius:0 4px 4px 0; }\n  .hfill.muted { background:#78716c; }\n  .hval { text-align:right; font-weight:600; color:var(--fg); font-variant-numeric:tabular-nums; }\n\n  /* Tooltips for the chart marks (hover or keyboard focus). */\n  .tip { position:absolute; bottom:calc(100% + 6px); left:50%; transform:translateX(-50%); z-index:5; pointer-events:none;\n         padding:6px 9px; border-radius:8px; font-size:11.5px; line-height:1.35; white-space:nowrap; color:var(--fg);\n         background:rgba(20, 17, 15, .92); border:1px solid var(--glass-edge); box-shadow:0 6px 18px rgba(0, 0, 0, .35);\n         opacity:0; transition:opacity .12s; }\n  .tip b { color:var(--fg); }\n  .col:hover .tip, .col:focus-visible .tip, .hbar:hover .tip, .hbar:focus-visible .tip { opacity:1; }\n  .hbar .tip { left:60%; }\n  @media (prefers-color-scheme: light) { .tip { background:rgba(250, 250, 249, .96); } .warn { color:#b45309; } }\n\n  /* =====================================================================================\n     Forecast graphics: timeline (past + forecast), risk histogram, spread compass, hotspot bars,\n     ranking gauge. Marks carry the colour; all text stays in text colours.\n     ===================================================================================== */\n  figure.chart { margin:0; }\n  figure.chart figcaption { margin-top:26px; font-size:11px; }\n  .dim { color:var(--faint); }\n  .strong { color:var(--fg); font-weight:600; }\n\n  /* Legend for the two-series timeline (observed vs forecast). */\n  .legend-row { display:flex; gap:14px; margin:0 0 6px; font-size:11.5px; color:var(--muted); }\n  .legend-row span { display:inline-flex; align-items:center; gap:6px; }\n  .sw { display:inline-block; width:12px; height:10px; border-radius:2px 2px 0 0; }\n  .sw.obs { background:#ea580c; }\n  .sw.fc { background:repeating-linear-gradient(45deg, #ea580c 0 2px, rgba(234, 88, 12, .35) 2px 5px); }\n\n  /* Timeline: forecast columns use the same hue as a 45° texture; the selected forecast day is outlined\n     by brightness, not a border. A \"today\" divider separates observed from forecast. */\n  .cols.timeline { gap:4px; }\n  .colbar.hatch { background:repeating-linear-gradient(45deg, #ea580c 0 2px, rgba(234, 88, 12, .35) 2px 5px); opacity:.65; }\n  button.col.fcol { padding:0; border:0; background:transparent; color:inherit; font:inherit; border-radius:0; cursor:pointer; }\n  button.col.fcol:hover:not(:disabled) { filter:none; }\n  .fcol.sel .colbar.hatch { opacity:1; }\n  .fcol.sel .coldate { color:var(--accent); font-weight:600; }\n  .fcol:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }\n  .today { position:relative; flex:none; width:1px; margin:0 3px; background:var(--line); }\n  .today span { position:absolute; top:100%; left:50%; transform:translateX(-50%); margin-top:5px;\n                font-size:10px; color:var(--faint); white-space:nowrap; letter-spacing:.04em; }\n\n  /* Risk histogram: each bar on a faint full-height track (keeps the darkest red visible on dark glass). */\n  .cols.hist { height:88px; margin-top:16px; }\n  .colbar-wrap.track { background:rgba(255, 255, 255, .05); border-radius:4px 4px 0 0; width:min(30px, 80%); margin:0 auto; }\n  .cols.hist .colbar { width:100%; }\n  .cols.hist .coldate { font-size:10px; }\n\n  /* Spread compass beside the spread/trend rows. */\n  .spread-row { display:flex; gap:14px; align-items:center; margin-top:16px; }\n  .spread-row .meta { flex:1; }\n  .compass { flex:none; }\n  .compass .c-ring { fill:rgba(255, 255, 255, .04); stroke:var(--line); stroke-width:1; }\n  .compass .c-tick { stroke:var(--faint); stroke-width:1.5; stroke-linecap:round; }\n  .compass .c-n { fill:var(--faint); font-size:8px; font-weight:600; text-anchor:middle; }\n  .compass .c-tail { stroke:#ea580c; stroke-width:2; stroke-linecap:round; opacity:.6; }\n  .compass .c-dot { fill:var(--faint); }\n\n  /* Hotspot rows: coordinates · a small probability bar · the percentage. */\n  .fgroup #hotspots .hot { display:grid; grid-template-columns:auto 1fr 38px; gap:12px; align-items:center; }\n  .fgroup #hotspots .hot b { text-align:right; color:var(--fg); }\n  .minibar { display:block; height:6px; border-radius:3px; background:rgba(255, 255, 255, .06); overflow:hidden; }\n  .minibar span { display:block; height:100%; background:#ea580c; border-radius:0 3px 3px 0; }\n\n  /* Ranking gauge: fire-orange arc on a lighter track of the same arc. */\n  .gauge-row { display:flex; gap:14px; align-items:center; }\n  .gauge { flex:none; }\n  .gauge .g-track { fill:none; stroke:rgba(234, 88, 12, .18); stroke-width:7; stroke-linecap:round; }\n  .gauge .g-fill { fill:none; stroke:#ea580c; stroke-width:7; stroke-linecap:round; }\n  .gauge .g-val { fill:var(--fg); font-size:13px; font-weight:700; text-anchor:middle; }\n  .gauge .g-end { fill:var(--faint); font-size:6.5px; text-anchor:middle; }\n  @media (prefers-color-scheme: light) {\n    .colbar-wrap.track, .minibar { background:rgba(28, 25, 23, .06); }\n    .compass .c-ring { fill:rgba(28, 25, 23, .03); }\n  }\n  /* Hidden tooltips near the panel edge must not make the panel scroll sideways. */\n  aside, .pscroll { overflow-x:hidden; }\n  /* Hotspot rows: a fixed column for the coordinates so every bar starts at the same point. */\n  .fgroup #hotspots .hot { grid-template-columns:96px 1fr 38px; }\n  .fgroup #hotspots .hot > span:first-child { text-align:left; }\n  /* Keep tooltips inside the panel: the first column's opens to the right, the last's to the left. */\n  .col:first-child .tip { left:0; transform:none; }\n  .cols > .col:last-child .tip, .cols > button.col:last-child .tip { left:auto; right:0; transform:none; }\n\n  /* ---------- Weather overlay ---------- */\n  /* On/off switch (forecast panel, Weather card header). */\n  .switch { position:relative; flex:none; width:40px; height:22px; margin:0; padding:0; border-radius:999px;\n                 border:1px solid var(--glass-edge); background:rgba(255, 255, 255, .1); cursor:pointer;\n            